/// A four-byte signature.
pub type Sig = [u8; 4];

/// Why a subrecord payload did not match its definition.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum DecodeError {
    /// The payload ended before `field` was complete.
    Truncated { field: &'static str, offset: usize },
    /// The payload has bytes left after the last field of `field`.
    Trailing { field: &'static str, offset: usize },
    /// The zstring `field` has no terminating NUL.
    Unterminated { field: &'static str },
    /// The count for the array `field` is negative or does not fit in `usize`.
    BadCount { field: &'static str, offset: usize },
    /// The union `field` has no layout for this record: no `EDID`, or an EditorID prefix
    /// no variant names.
    Undecided { field: &'static str },
}

impl std::fmt::Display for DecodeError {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        match self {
            Self::Truncated { field, offset } => {
                write!(f, "{field}: payload ends at offset {offset}")
            }
            Self::Trailing { field, offset } => {
                write!(f, "{field}: unexpected bytes from offset {offset}")
            }
            Self::Unterminated { field } => write!(f, "{field}: string has no terminating NUL"),
            Self::BadCount { field, offset } => {
                write!(f, "{field}: invalid element count at offset {offset}")
            }
            Self::Undecided { field } => {
                write!(f, "{field}: no layout for this record's EditorID prefix")
            }
        }
    }
}

impl std::error::Error for DecodeError {}

/// Facts from the plugin and the record header that change layouts.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]
pub struct Ctx {
    /// The record's form version (record header).
    pub form_version: u16,
    /// Whether the plugin is localized: the container passes the TES4 header's localized
    /// flag (`0x80`) to every record of the plugin. Decides how `lstring` fields decode.
    pub localized: bool,
}

impl Ctx {
    /// Whether a field present in form versions `since..=until` is present here.
    pub fn has(self, since: Option<u16>, until: Option<u16>) -> bool {
        since.is_none_or(|s| self.form_version >= s) && until.is_none_or(|u| self.form_version <= u)
    }
}

/// Bounds-checked little-endian reader over one payload.
#[derive(Debug, Clone)]
pub struct Reader<'a> {
    data: &'a [u8],
    pos: usize,
}

impl<'a> Reader<'a> {
    /// A reader at the start of `data`.
    pub fn new(data: &'a [u8]) -> Self {
        Self { data, pos: 0 }
    }

    /// Bytes consumed so far.
    pub fn position(&self) -> usize {
        self.pos
    }

    /// Whether every byte has been consumed.
    pub fn is_empty(&self) -> bool {
        self.pos >= self.data.len()
    }

    /// The next `n` bytes.
    pub fn take(&mut self, n: usize, field: &'static str) -> Result<&'a [u8], DecodeError> {
        let truncated = DecodeError::Truncated {
            field,
            offset: self.pos,
        };
        let end = self.pos.checked_add(n).ok_or(truncated)?;
        let bytes = self.data.get(self.pos..end).ok_or(truncated)?;
        self.pos = end;
        Ok(bytes)
    }

    /// Everything not consumed yet.
    pub fn rest(&mut self) -> &'a [u8] {
        let bytes = self.data.get(self.pos..).unwrap_or_default();
        self.pos = self.data.len();
        bytes
    }

    /// Fails when bytes are left over.
    pub fn finish(&self, field: &'static str) -> Result<(), DecodeError> {
        if self.is_empty() {
            Ok(())
        } else {
            Err(DecodeError::Trailing {
                field,
                offset: self.pos,
            })
        }
    }
}

/// A value with a binary layout. `write` reproduces the bytes `read` consumed.
pub trait Field: Sized {
    /// Reads one value; `field` names it in errors.
    fn read(r: &mut Reader<'_>, field: &'static str, ctx: Ctx) -> Result<Self, DecodeError>;
    /// Appends the value's bytes.
    fn write(&self, out: &mut Vec<u8>);
}

macro_rules! scalar_field {
    ($($t:ty),*) => {$(
        impl Field for $t {
            fn read(r: &mut Reader<'_>, field: &'static str, _ctx: Ctx) -> Result<Self, DecodeError> {
                let offset = r.position();
                let bytes = r.take(core::mem::size_of::<$t>(), field)?;
                let array = bytes
                    .try_into()
                    .map_err(|_| DecodeError::Truncated { field, offset })?;
                Ok(<$t>::from_le_bytes(array))
            }

            fn write(&self, out: &mut Vec<u8>) {
                out.extend_from_slice(&self.to_le_bytes());
            }
        }
    )*};
}

scalar_field!(u8, i8, u16, i16, u32, i32, u64, i64, f32, f64);

/// A fixed-count array: exactly `N` elements, so its encoded size cannot drift.
impl<T: Field, const N: usize> Field for [T; N] {
    fn read(r: &mut Reader<'_>, field: &'static str, ctx: Ctx) -> Result<Self, DecodeError> {
        let offset = r.position();
        read_array(r, N, field, ctx)?
            .try_into()
            .map_err(|_| DecodeError::Truncated { field, offset })
    }

    fn write(&self, out: &mut Vec<u8>) {
        write_all(self, out);
    }
}

/// A "rest" array: elements until the payload is used up.
impl<T: Field> Field for Vec<T> {
    fn read(r: &mut Reader<'_>, field: &'static str, ctx: Ctx) -> Result<Self, DecodeError> {
        read_rest(r, field, ctx)
    }

    fn write(&self, out: &mut Vec<u8>) {
        write_all(self, out);
    }
}

/// A 32-bit FormID as stored (master index in the top byte).
#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash, Default)]
pub struct FormId(pub u32);

impl Field for FormId {
    fn read(r: &mut Reader<'_>, field: &'static str, ctx: Ctx) -> Result<Self, DecodeError> {
        u32::read(r, field, ctx).map(Self)
    }

    fn write(&self, out: &mut Vec<u8>) {
        self.0.write(out);
    }
}

/// NUL-terminated string bytes without the terminator. The encoding is not interpreted.
#[derive(Debug, Clone, PartialEq, Eq, Default)]
pub struct ZString(pub Vec<u8>);

impl Field for ZString {
    fn read(r: &mut Reader<'_>, field: &'static str, _ctx: Ctx) -> Result<Self, DecodeError> {
        match r.rest().split_last() {
            Some((0, text)) => Ok(Self(text.to_vec())),
            _ => Err(DecodeError::Unterminated { field }),
        }
    }

    fn write(&self, out: &mut Vec<u8>) {
        out.extend_from_slice(&self.0);
        out.push(0);
    }
}

/// A localized string (`lstring`), decoded by [`Ctx::localized`]: a string-table ID in a
/// localized plugin, NUL-terminated text otherwise. A payload that does not fit the
/// plugin's mode (not 4 bytes, or no NUL) fails to decode and stays raw in `extra`.
#[derive(Debug, Clone, PartialEq, Eq)]
pub enum LString {
    /// A string-table ID (localized plugin).
    Id(u32),
    /// Inline text (plugin not localized).
    Text(ZString),
}

impl Field for LString {
    fn read(r: &mut Reader<'_>, field: &'static str, ctx: Ctx) -> Result<Self, DecodeError> {
        if ctx.localized {
            u32::read(r, field, ctx).map(Self::Id)
        } else {
            ZString::read(r, field, ctx).map(Self::Text)
        }
    }

    fn write(&self, out: &mut Vec<u8>) {
        match self {
            Self::Id(id) => id.write(out),
            Self::Text(text) => text.write(out),
        }
    }
}

/// Text with a `u16` length prefix and no terminator (`wstring`). The bytes are not
/// interpreted. Writing more than `u16::MAX` bytes keeps only the first `u16::MAX`.
#[derive(Debug, Clone, PartialEq, Eq, Default)]
pub struct WString(pub Vec<u8>);

impl Field for WString {
    fn read(r: &mut Reader<'_>, field: &'static str, ctx: Ctx) -> Result<Self, DecodeError> {
        let len = u16::read(r, field, ctx)?;
        Ok(Self(r.take(usize::from(len), field)?.to_vec()))
    }

    fn write(&self, out: &mut Vec<u8>) {
        let len = u16::try_from(self.0.len()).unwrap_or(u16::MAX);
        len.write(out);
        out.extend_from_slice(self.0.get(..usize::from(len)).unwrap_or_default());
    }
}

/// Text with a `u8` length prefix and no terminator (`bstring`). The bytes are not
/// interpreted. Writing more than `u8::MAX` bytes keeps only the first `u8::MAX`.
#[derive(Debug, Clone, PartialEq, Eq, Default)]
pub struct BString(pub Vec<u8>);

impl Field for BString {
    fn read(r: &mut Reader<'_>, field: &'static str, ctx: Ctx) -> Result<Self, DecodeError> {
        let len = u8::read(r, field, ctx)?;
        Ok(Self(r.take(usize::from(len), field)?.to_vec()))
    }

    fn write(&self, out: &mut Vec<u8>) {
        let len = u8::try_from(self.0.len()).unwrap_or(u8::MAX);
        len.write(out);
        out.extend_from_slice(self.0.get(..usize::from(len)).unwrap_or_default());
    }
}

/// Bytes that are not decoded.
#[derive(Debug, Clone, PartialEq, Eq, Default)]
pub struct Bytes(pub Vec<u8>);

impl Field for Bytes {
    fn read(r: &mut Reader<'_>, _field: &'static str, _ctx: Ctx) -> Result<Self, DecodeError> {
        Ok(Self(r.rest().to_vec()))
    }

    fn write(&self, out: &mut Vec<u8>) {
        out.extend_from_slice(&self.0);
    }
}

/// A zero-length marker payload.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]
pub struct Empty;

impl Field for Empty {
    fn read(_r: &mut Reader<'_>, _field: &'static str, _ctx: Ctx) -> Result<Self, DecodeError> {
        Ok(Self)
    }

    fn write(&self, _out: &mut Vec<u8>) {}
}

/// Reads exactly `count` elements. Every element consumes at least one byte, so a
/// hostile count fails at the end of the payload instead of looping.
pub fn read_array<T: Field>(
    r: &mut Reader<'_>,
    count: usize,
    field: &'static str,
    ctx: Ctx,
) -> Result<Vec<T>, DecodeError> {
    let mut out = Vec::new();
    for _ in 0..count {
        let before = r.position();
        out.push(T::read(r, field, ctx)?);
        if r.position() == before {
            return Err(DecodeError::Truncated {
                field,
                offset: before,
            });
        }
    }
    Ok(out)
}

/// Reads elements until the payload is used up.
pub fn read_rest<T: Field>(
    r: &mut Reader<'_>,
    field: &'static str,
    ctx: Ctx,
) -> Result<Vec<T>, DecodeError> {
    let mut out = Vec::new();
    while !r.is_empty() {
        let before = r.position();
        out.push(T::read(r, field, ctx)?);
        if r.position() == before {
            break;
        }
    }
    Ok(out)
}

/// Converts the value of a count field (`count_from`) to an element count.
pub fn count<T: TryInto<usize>>(
    value: T,
    field: &'static str,
    offset: usize,
) -> Result<usize, DecodeError> {
    value
        .try_into()
        .map_err(|_| DecodeError::BadCount { field, offset })
}

/// Writes every element in order.
pub fn write_all<T: Field>(items: &[T], out: &mut Vec<u8>) {
    for item in items {
        item.write(out);
    }
}

/// Decodes a whole payload; leftover bytes are an error.
pub fn decode<T: Field>(data: &[u8], field: &'static str, ctx: Ctx) -> Result<T, DecodeError> {
    let mut r = Reader::new(data);
    let value = T::read(&mut r, field, ctx)?;
    r.finish(field)?;
    Ok(value)
}

/// Encodes a payload.
pub fn encode<T: Field>(value: &T) -> Vec<u8> {
    let mut out = Vec::new();
    value.write(&mut out);
    out
}

/// A subrecord as read from a record body.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub struct RawSub<'a> {
    pub signature: Sig,
    pub data: &'a [u8],
    /// The size came from a preceding `XXXX` subrecord instead of the subrecord's own
    /// `u16` size field. Decoding carries this into [`Sub::oversized`] or `extra`, and
    /// encoding gives it back, so an unmodified record is written with `XXXX` exactly where
    /// it was read with one, whatever the payload size.
    pub oversized: bool,
}

/// An owned subrecord; `oversized` as on [`RawSub`]. When it is `false` and the payload
/// is longer than `u16::MAX`, the container still has to write an `XXXX` prefix.
#[derive(Debug, Clone, PartialEq, Eq)]
pub struct OwnedSub {
    pub signature: Sig,
    pub data: Vec<u8>,
    pub oversized: bool,
}

impl From<&RawSub<'_>> for OwnedSub {
    fn from(raw: &RawSub<'_>) -> Self {
        Self {
            signature: raw.signature,
            data: raw.data.to_vec(),
            oversized: raw.oversized,
        }
    }
}

/// A decoded subrecord value together with how its size was stored (see
/// [`RawSub::oversized`]). Dereferences to the value.
#[derive(Debug, Clone, PartialEq, Default)]
pub struct Sub<T> {
    pub value: T,
    pub oversized: bool,
}

impl<T> Sub<T> {
    /// A value stored with a plain `u16` size.
    pub fn new(value: T) -> Self {
        Self {
            value,
            oversized: false,
        }
    }
}

impl<T> From<T> for Sub<T> {
    fn from(value: T) -> Self {
        Self::new(value)
    }
}

impl<T> std::ops::Deref for Sub<T> {
    type Target = T;

    fn deref(&self) -> &T {
        &self.value
    }
}

impl<T> std::ops::DerefMut for Sub<T> {
    fn deref_mut(&mut self) -> &mut T {
        &mut self.value
    }
}

/// How often a member may occur.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum Card {
    Required,
    Optional,
    Repeated,
}

/// One member of a record or group, as the matcher sees it.
#[derive(Debug, Clone, Copy)]
pub enum MemberDesc {
    /// One subrecord signature.
    Sub { sig: Sig, card: Card },
    /// A run of consecutive members.
    Group {
        card: Card,
        members: &'static [MemberDesc],
    },
    /// Any subrecords up to the first `until`.
    AnyUntil { until: Sig },
}

/// FormID values, each with the path of the member or field that holds it (`WEAP.KWDA`).
pub type FormIds<'a> = Vec<(&'static str, &'a FormId)>;

/// Mutable FormID values with their paths.
pub type FormIdsMut<'a> = Vec<(&'static str, &'a mut FormId)>;

/// Localized-string values with their paths.
pub type LStrings<'a> = Vec<(&'static str, &'a LString)>;

/// Mutable localized-string values with their paths.
pub type LStringsMut<'a> = Vec<(&'static str, &'a mut LString)>;

/// Walks the typed values of a decoded record: every `formid` and every `lstring` value, in
/// definition order, with the path of the member or field that holds it. FormIDs are the
/// raw stored values (master index in the top byte); resolving them against a load order
/// is not this module's job. Subrecords kept raw (`extra`, `any_until` bodies, opaque
/// payloads) are not visited: whatever they hold is unknown to the schema.
pub trait Visit {
    /// Appends every FormID value; `path` names `self` when it is one.
    fn visit_form_ids<'a>(&'a self, _path: &'static str, _out: &mut FormIds<'a>) {}

    /// Appends every FormID value, mutably.
    fn visit_form_ids_mut<'a>(&'a mut self, _path: &'static str, _out: &mut FormIdsMut<'a>) {}

    /// Appends every lstring value; `path` names `self` when it is one.
    fn visit_lstrings<'a>(&'a self, _path: &'static str, _out: &mut LStrings<'a>) {}

    /// Appends every lstring value, mutably.
    fn visit_lstrings_mut<'a>(&'a mut self, _path: &'static str, _out: &mut LStringsMut<'a>) {}
}

/// [`Visit::visit_form_ids`] as a free function (generated code calls these).
pub fn visit_form_ids<'a, T: Visit>(value: &'a T, path: &'static str, out: &mut FormIds<'a>) {
    value.visit_form_ids(path, out);
}

/// [`Visit::visit_form_ids_mut`] as a free function.
pub fn visit_form_ids_mut<'a, T: Visit>(
    value: &'a mut T,
    path: &'static str,
    out: &mut FormIdsMut<'a>,
) {
    value.visit_form_ids_mut(path, out);
}

/// [`Visit::visit_lstrings`] as a free function.
pub fn visit_lstrings<'a, T: Visit>(value: &'a T, path: &'static str, out: &mut LStrings<'a>) {
    value.visit_lstrings(path, out);
}

/// [`Visit::visit_lstrings_mut`] as a free function.
pub fn visit_lstrings_mut<'a, T: Visit>(
    value: &'a mut T,
    path: &'static str,
    out: &mut LStringsMut<'a>,
) {
    value.visit_lstrings_mut(path, out);
}

macro_rules! no_visit {
    ($($t:ty),*) => {$(
        impl Visit for $t {}
    )*};
}

no_visit!(u8, i8, u16, i16, u32, i32, u64, i64, f32, f64);
no_visit!(ZString, WString, BString, Bytes, Empty, OwnedSub);

impl Visit for FormId {
    fn visit_form_ids<'a>(&'a self, path: &'static str, out: &mut FormIds<'a>) {
        out.push((path, self));
    }

    fn visit_form_ids_mut<'a>(&'a mut self, path: &'static str, out: &mut FormIdsMut<'a>) {
        out.push((path, self));
    }
}

impl Visit for LString {
    fn visit_lstrings<'a>(&'a self, path: &'static str, out: &mut LStrings<'a>) {
        out.push((path, self));
    }

    fn visit_lstrings_mut<'a>(&'a mut self, path: &'static str, out: &mut LStringsMut<'a>) {
        out.push((path, self));
    }
}

impl<T: Visit> Visit for Sub<T> {
    fn visit_form_ids<'a>(&'a self, path: &'static str, out: &mut FormIds<'a>) {
        self.value.visit_form_ids(path, out);
    }

    fn visit_form_ids_mut<'a>(&'a mut self, path: &'static str, out: &mut FormIdsMut<'a>) {
        self.value.visit_form_ids_mut(path, out);
    }

    fn visit_lstrings<'a>(&'a self, path: &'static str, out: &mut LStrings<'a>) {
        self.value.visit_lstrings(path, out);
    }

    fn visit_lstrings_mut<'a>(&'a mut self, path: &'static str, out: &mut LStringsMut<'a>) {
        self.value.visit_lstrings_mut(path, out);
    }
}

impl<T: Visit> Visit for Option<T> {
    fn visit_form_ids<'a>(&'a self, path: &'static str, out: &mut FormIds<'a>) {
        if let Some(value) = self {
            value.visit_form_ids(path, out);
        }
    }

    fn visit_form_ids_mut<'a>(&'a mut self, path: &'static str, out: &mut FormIdsMut<'a>) {
        if let Some(value) = self {
            value.visit_form_ids_mut(path, out);
        }
    }

    fn visit_lstrings<'a>(&'a self, path: &'static str, out: &mut LStrings<'a>) {
        if let Some(value) = self {
            value.visit_lstrings(path, out);
        }
    }

    fn visit_lstrings_mut<'a>(&'a mut self, path: &'static str, out: &mut LStringsMut<'a>) {
        if let Some(value) = self {
            value.visit_lstrings_mut(path, out);
        }
    }
}

impl<T: Visit> Visit for Vec<T> {
    fn visit_form_ids<'a>(&'a self, path: &'static str, out: &mut FormIds<'a>) {
        for value in self {
            value.visit_form_ids(path, out);
        }
    }

    fn visit_form_ids_mut<'a>(&'a mut self, path: &'static str, out: &mut FormIdsMut<'a>) {
        for value in self {
            value.visit_form_ids_mut(path, out);
        }
    }

    fn visit_lstrings<'a>(&'a self, path: &'static str, out: &mut LStrings<'a>) {
        for value in self {
            value.visit_lstrings(path, out);
        }
    }

    fn visit_lstrings_mut<'a>(&'a mut self, path: &'static str, out: &mut LStringsMut<'a>) {
        for value in self {
            value.visit_lstrings_mut(path, out);
        }
    }
}

impl<T: Visit, const N: usize> Visit for [T; N] {
    fn visit_form_ids<'a>(&'a self, path: &'static str, out: &mut FormIds<'a>) {
        for value in self {
            value.visit_form_ids(path, out);
        }
    }

    fn visit_form_ids_mut<'a>(&'a mut self, path: &'static str, out: &mut FormIdsMut<'a>) {
        for value in self {
            value.visit_form_ids_mut(path, out);
        }
    }

    fn visit_lstrings<'a>(&'a self, path: &'static str, out: &mut LStrings<'a>) {
        for value in self {
            value.visit_lstrings(path, out);
        }
    }

    fn visit_lstrings_mut<'a>(&'a mut self, path: &'static str, out: &mut LStringsMut<'a>) {
        for value in self {
            value.visit_lstrings_mut(path, out);
        }
    }
}

/// Where the matcher put input subrecords.
#[derive(Debug, Clone, PartialEq, Eq)]
pub enum Hit {
    /// Subrecord `index` belongs to member `member`.
    Sub { member: usize, index: usize },
    /// One instance of group member `member`.
    Group { member: usize, hits: Vec<Hit> },
}

const MAX_GROUP_DEPTH: usize = 16;

fn accepts(desc: &MemberDesc, sig: Sig, depth: usize) -> bool {
    match desc {
        MemberDesc::Sub { sig: own, .. } => *own == sig,
        MemberDesc::AnyUntil { until } => *until != sig,
        MemberDesc::Group { members, .. } => {
            depth < MAX_GROUP_DEPTH && starts(members, sig, depth.saturating_add(1))
        }
    }
}

fn starts(members: &[MemberDesc], sig: Sig, depth: usize) -> bool {
    for desc in members {
        if accepts(desc, sig, depth) {
            return true;
        }
        let required = match desc {
            MemberDesc::Sub { card, .. } | MemberDesc::Group { card, .. } => {
                *card == Card::Required
            }
            MemberDesc::AnyUntil { .. } => false,
        };
        if required {
            return false;
        }
    }
    false
}

fn repeats(desc: &MemberDesc) -> bool {
    match desc {
        MemberDesc::Sub { card, .. } | MemberDesc::Group { card, .. } => *card == Card::Repeated,
        MemberDesc::AnyUntil { .. } => true,
    }
}

fn match_one(
    subs: &[RawSub<'_>],
    pos: &mut usize,
    members: &'static [MemberDesc],
    cursor: &mut usize,
    depth: usize,
) -> Option<Hit> {
    let sig = subs.get(*pos)?.signature;
    let (member, desc) = members
        .iter()
        .enumerate()
        .skip(*cursor)
        .find(|(_, desc)| accepts(desc, sig, depth))?;
    *cursor = if repeats(desc) {
        member
    } else {
        member.saturating_add(1)
    };
    if let MemberDesc::Group { members: inner, .. } = desc {
        let start = *pos;
        let mut inner_cursor = 0;
        let mut hits = Vec::new();
        while let Some(hit) =
            match_one(subs, pos, inner, &mut inner_cursor, depth.saturating_add(1))
        {
            hits.push(hit);
        }
        if *pos == start {
            return None;
        }
        return Some(Hit::Group { member, hits });
    }
    let index = *pos;
    *pos = pos.saturating_add(1);
    Some(Hit::Sub { member, index })
}

/// Assigns subrecords to `members` in order. Returns the hits and the indexes of
/// subrecords that no member accepted at their position.
pub fn match_members(
    subs: &[RawSub<'_>],
    members: &'static [MemberDesc],
) -> (Vec<Hit>, Vec<usize>) {
    let mut pos = 0;
    let mut cursor = 0;
    let mut hits = Vec::new();
    let mut unmatched = Vec::new();
    while pos < subs.len() {
        match match_one(subs, &mut pos, members, &mut cursor, 0) {
            Some(hit) => hits.push(hit),
            None => {
                unmatched.push(pos);
                pos = pos.saturating_add(1);
            }
        }
    }
    (hits, unmatched)
}

/// [`match_members`] for a record whose members may occur in any order (`unordered = true`
/// on its definition, as upstream marks CELL, REFR and ACHR): a subrecord is matched from
/// the current member on, as [`match_members`] does, and when no member from there accepts
/// it, from the first member again. A group still matches one consecutive run, in its own
/// order; a subrecord no member accepts is unmatched.
pub fn match_unordered(
    subs: &[RawSub<'_>],
    members: &'static [MemberDesc],
) -> (Vec<Hit>, Vec<usize>) {
    let mut pos = 0;
    let mut cursor = 0;
    let mut hits = Vec::new();
    let mut unmatched = Vec::new();
    while pos < subs.len() {
        let mut hit = match_one(subs, &mut pos, members, &mut cursor, 0);
        if hit.is_none() {
            let mut wrapped = 0;
            hit = match_one(subs, &mut pos, members, &mut wrapped, 0);
            if hit.is_some() {
                cursor = wrapped;
            }
        }
        match hit {
            Some(hit) => hits.push(hit),
            None => {
                unmatched.push(pos);
                pos = pos.saturating_add(1);
            }
        }
    }
    (hits, unmatched)
}

impl Hit {
    /// The member (an index into its member list) this hit belongs to.
    pub fn member(&self) -> usize {
        match self {
            Self::Sub { member, .. } | Self::Group { member, .. } => *member,
        }
    }
}

/// The values of one member of a record or group: optional (`Option`) or a list (`Vec`).
pub trait Slots {
    /// One value.
    type Item;

    /// How many values the member holds.
    fn count_values(&self) -> usize;

    /// The `n`th value, if there is one.
    fn nth_value(&self, n: usize) -> Option<&Self::Item>;
}

impl<T> Slots for Option<T> {
    type Item = T;

    fn count_values(&self) -> usize {
        usize::from(self.is_some())
    }

    fn nth_value(&self, n: usize) -> Option<&T> {
        if n == 0 {
            self.as_ref()
        } else {
            None
        }
    }
}

impl<T> Slots for Vec<T> {
    type Item = T;

    fn count_values(&self) -> usize {
        self.len()
    }

    fn nth_value(&self, n: usize) -> Option<&T> {
        self.get(n)
    }
}

/// A record whose members may occur in any order. Decoding records the member of every
/// typed value in on-disk order (`disk_order`), and encoding writes the values back in that
/// order, so an unedited record re-encodes byte for byte; values added since decoding are
/// written after the recorded ones, member by member.
pub trait Unordered {
    /// How many values member `member` holds.
    fn occurrences(&self, member: usize) -> usize;

    /// Appends the `n`th value of member `member` (a whole group for a group member), if
    /// it has one.
    fn emit_nth(&self, member: usize, n: usize, out: &mut Vec<OwnedSub>);
}

/// Records that a value of `member` was decoded (the next entry of a `disk_order`).
pub fn note_order(order: &mut Vec<u16>, member: usize) {
    if let Ok(member) = u16::try_from(member) {
        order.push(member);
    }
}

/// Emits the values of an unordered record: for each `order` entry the next value of that
/// member that is still there, then every value no entry reached (added since decoding),
/// member by member.
pub fn emit_unordered<T: Unordered>(
    value: &T,
    order: &[u16],
    members: usize,
    out: &mut Vec<OwnedSub>,
) {
    let mut next = vec![0usize; members];
    for &member in order {
        let member = usize::from(member);
        if let Some(n) = next.get_mut(member) {
            if *n < value.occurrences(member) {
                value.emit_nth(member, *n, out);
                *n = n.saturating_add(1);
            }
        }
    }
    for (member, &n) in next.iter().enumerate() {
        for k in n..value.occurrences(member) {
            value.emit_nth(member, k, out);
        }
    }
}

/// Decodes subrecord `index` into an empty slot, or keeps it raw in `extra`.
pub fn put<T: Field>(
    slot: &mut Option<Sub<T>>,
    subs: &[RawSub<'_>],
    index: usize,
    field: &'static str,
    ctx: Ctx,
    extra: &mut Vec<(usize, OwnedSub)>,
) {
    let Some(sub) = subs.get(index) else {
        return;
    };
    match decode::<T>(sub.data, field, ctx) {
        Ok(value) if slot.is_none() => {
            *slot = Some(Sub {
                value,
                oversized: sub.oversized,
            });
        }
        _ => extra.push((index, OwnedSub::from(sub))),
    }
}

/// Decodes subrecord `index` onto a list, or keeps it raw in `extra`.
pub fn push<T: Field>(
    list: &mut Vec<Sub<T>>,
    subs: &[RawSub<'_>],
    index: usize,
    field: &'static str,
    ctx: Ctx,
    extra: &mut Vec<(usize, OwnedSub)>,
) {
    let Some(sub) = subs.get(index) else {
        return;
    };
    match decode::<T>(sub.data, field, ctx) {
        Ok(value) => list.push(Sub {
            value,
            oversized: sub.oversized,
        }),
        Err(_) => extra.push((index, OwnedSub::from(sub))),
    }
}

/// A union payload whose layout the record's EditorID prefix selects (`type = "union"`,
/// `decider = "edid-prefix"`).
pub trait ByPrefix: Sized {
    /// Reads the variant that EditorID prefix byte `prefix` selects.
    fn read_for(
        prefix: u8,
        r: &mut Reader<'_>,
        field: &'static str,
        ctx: Ctx,
    ) -> Result<Self, DecodeError>;
}

/// The first byte of the first `EDID` payload in `subs`.
pub fn edid_prefix(subs: &[RawSub<'_>]) -> Option<u8> {
    subs.iter()
        .find(|s| s.signature == *b"EDID")
        .and_then(|s| s.data.first().copied())
}

/// Decodes a whole union payload by the record's EditorID prefix.
pub fn decode_by_prefix<T: ByPrefix>(
    subs: &[RawSub<'_>],
    data: &[u8],
    field: &'static str,
    ctx: Ctx,
) -> Result<T, DecodeError> {
    let prefix = edid_prefix(subs).ok_or(DecodeError::Undecided { field })?;
    let mut r = Reader::new(data);
    let value = T::read_for(prefix, &mut r, field, ctx)?;
    r.finish(field)?;
    Ok(value)
}

/// [`put`] for a union member: decodes by the EditorID prefix, or keeps the subrecord raw.
pub fn put_by_prefix<T: ByPrefix>(
    slot: &mut Option<Sub<T>>,
    subs: &[RawSub<'_>],
    index: usize,
    field: &'static str,
    ctx: Ctx,
    extra: &mut Vec<(usize, OwnedSub)>,
) {
    let Some(sub) = subs.get(index) else {
        return;
    };
    match decode_by_prefix::<T>(subs, sub.data, field, ctx) {
        Ok(value) if slot.is_none() => {
            *slot = Some(Sub {
                value,
                oversized: sub.oversized,
            });
        }
        _ => extra.push((index, OwnedSub::from(sub))),
    }
}

/// [`push`] for a repeated union member.
pub fn push_by_prefix<T: ByPrefix>(
    list: &mut Vec<Sub<T>>,
    subs: &[RawSub<'_>],
    index: usize,
    field: &'static str,
    ctx: Ctx,
    extra: &mut Vec<(usize, OwnedSub)>,
) {
    let Some(sub) = subs.get(index) else {
        return;
    };
    match decode_by_prefix::<T>(subs, sub.data, field, ctx) {
        Ok(value) => list.push(Sub {
            value,
            oversized: sub.oversized,
        }),
        Err(_) => extra.push((index, OwnedSub::from(sub))),
    }
}

/// Keeps subrecord `index` raw on a list, `oversized` included.
pub fn push_raw(list: &mut Vec<OwnedSub>, subs: &[RawSub<'_>], index: usize) {
    if let Some(sub) = subs.get(index) {
        list.push(OwnedSub::from(sub));
    }
}

/// Moves every subrecord under `hit` to `extra`.
pub fn unmatched(hit: &Hit, subs: &[RawSub<'_>], extra: &mut Vec<(usize, OwnedSub)>) {
    match hit {
        Hit::Sub { index, .. } => {
            if let Some(sub) = subs.get(*index) {
                extra.push((*index, OwnedSub::from(sub)));
            }
        }
        Hit::Group { hits, .. } => {
            for inner in hits {
                unmatched(inner, subs, extra);
            }
        }
    }
}

/// Appends an encoded subrecord when `value` is present, with its `oversized` flag.
pub fn emit<T: Field>(out: &mut Vec<OwnedSub>, signature: Sig, value: Option<&Sub<T>>) {
    if let Some(sub) = value {
        out.push(OwnedSub {
            signature,
            data: encode(&sub.value),
            oversized: sub.oversized,
        });
    }
}

/// Re-inserts `extra` subrecords at their original indexes, lowest first: each one lands
/// at position `index` of the output built so far (or at the end when the output is
/// shorter). When the typed members were emitted in input order this reproduces the input
/// exactly; after edits that add or remove typed values, an index is kept as a number, not
/// as a position next to particular neighbours.
pub fn merge_extra(mut ordered: Vec<OwnedSub>, extra: &[(usize, OwnedSub)]) -> Vec<OwnedSub> {
    let mut sorted: Vec<&(usize, OwnedSub)> = extra.iter().collect();
    sorted.sort_by_key(|(index, _)| *index);
    for (index, sub) in sorted {
        let at = (*index).min(ordered.len());
        ordered.insert(at, sub.clone());
    }
    ordered
}
